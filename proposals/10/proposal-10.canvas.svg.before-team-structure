    <line id="c-next-1" x1="1496.0" y1="456.0" x2="1656.0" y2="456.0" data-start="c-design" data-end="c-pilot" data-start-side="right" data-end-side="left" stroke="#313131" stroke-width="2" data-arrow="end" data-shape="elbowed" data-content="Next" />

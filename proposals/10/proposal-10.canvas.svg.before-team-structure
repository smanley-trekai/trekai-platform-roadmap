<?xml version='1.0' encoding='utf-8'?>
<svg xmlns="http://www.w3.org/2000/svg" width="11600" height="32600">
  <g id="p10a" transform="translate(-2560,30500)" data-frame="10A Role-based access and PAM: baseline plus temporary elevation">
    <rect data-type="frame" x="0" y="0" width="3152" height="1910" fill="#ffffff" data-title="10A Role-based access and PAM: baseline plus temporary elevation" />
    <textArea id="p10a-title" x="64" y="64" width="3024" height="64" fill="#1a1a1a" font-family="noto_sans" font-size="33" text-align="left" font-weight="bold">10A Role-based access and PAM: baseline plus temporary elevation</textArea>
    <textArea id="p10a-subtitle" x="64" y="148" width="3024" height="40" fill="#595959" font-family="noto_sans" font-size="22" text-align="left" font-weight="normal">CTO / developers / QA / DevOps / access owners | Draft | Give each job an agreed baseline and make additional privileged access scoped, eligible and time-bound.</textArea>
    <textArea id="p10a-legend" x="64" y="1750" width="3024" height="40" fill="#595959" font-family="noto_sans" font-size="18" text-align="left" font-weight="normal">Blue = proposed | Gray = reported context or reference | Yellow = exception, boundary or team decision</textArea>
    <textArea id="a-current" x="64" y="244" width="880" height="40" fill="#1a1a1a" font-family="noto_sans" font-size="22" text-align="left" font-weight="bold">Inputs and the requested change</textArea>
    <rect id="a-team-model" x="64" y="320" width="880" height="192" data-content="&lt;b&gt;Agree team structure and normal job needs&lt;/b&gt;&lt;br&gt;Identify application, QA, DevOps and other staff tasks.&lt;br&gt;Define the normal roles and resource/repository scope.&lt;br&gt;Use the identity and mapping models from 08 and 09." fill="#ddddd8" stroke="#a8a8a0" stroke-width="2" data-text-color="#434339" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <rect id="a-inventory" x="64" y="552" width="880" height="192" data-content="&lt;b&gt;Inventory standing access and existing controls&lt;/b&gt;&lt;br&gt;Review direct/group/inherited grants and current elevation tools.&lt;br&gt;Identify tasks that need temporary additional privileges.&lt;br&gt;Current entitlements, configuration and coverage remain to verify." fill="#ddddd8" stroke="#a8a8a0" stroke-width="2" data-text-color="#434339" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <rect id="a-intent" x="64" y="784" width="880" height="224" data-content="&lt;b&gt;Request temporary access for an explicit task&lt;/b&gt;&lt;br&gt;The Nov 12 discussion separates default access from elevation.&lt;br&gt;Read versus write was an example, not a universal role policy.&lt;br&gt;Agree the smallest useful privilege scope and its owner." fill="#ffe86d" stroke="#cbb333" stroke-width="2" data-text-color="#574900" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <textArea id="a-proposed" x="1104" y="244" width="1984" height="40" fill="#1a1a1a" font-family="noto_sans" font-size="22" text-align="left" font-weight="bold">Proposed: maintained baseline and a separate temporary-access path</textArea>
    <rect id="a-team" x="1104" y="320" width="576" height="192" data-content="&lt;b&gt;Agreed team / job role&lt;/b&gt;&lt;br&gt;Required day-to-day tasks.&lt;br&gt;Target product and environment.&lt;br&gt;Named role and access owners." fill="#a0c4fb" stroke="#6a8bbf" stroke-width="2" data-text-color="#14315e" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <rect id="a-group" x="1808" y="320" width="576" height="192" data-content="&lt;b&gt;Approved membership / mapping&lt;/b&gt;&lt;br&gt;Owned identity group and target mapping.&lt;br&gt;Joiner/mover/leaver approvals.&lt;br&gt;Eligibility is separately defined." fill="#a0c4fb" stroke="#6a8bbf" stroke-width="2" data-text-color="#14315e" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <rect id="a-baseline" x="2512" y="320" width="576" height="192" data-content="&lt;b&gt;Baseline access at the target&lt;/b&gt;&lt;br&gt;Approved role and resource/repo scope.&lt;br&gt;Maintained while separately authorized.&lt;br&gt;Normal task follows its existing controls." fill="#a0c4fb" stroke="#6a8bbf" stroke-width="2" data-text-color="#14315e" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <rect id="a-catalog" x="1104" y="672" width="576" height="192" data-content="&lt;b&gt;Predefined entitlement&lt;/b&gt;&lt;br&gt;Target system, resource scope and roles.&lt;br&gt;Eligible requesters and approval policy.&lt;br&gt;Maximum duration and accountable owner." fill="#a0c4fb" stroke="#6a8bbf" stroke-width="2" data-text-color="#14315e" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <rect id="a-request" x="1808" y="672" width="576" height="192" data-content="&lt;b&gt;Eligible user requests a grant&lt;/b&gt;&lt;br&gt;Select entitlement, reason and duration.&lt;br&gt;Apply configured approval/controls.&lt;br&gt;Pending or declined requests grant no access." fill="#a0c4fb" stroke="#6a8bbf" stroke-width="2" data-text-color="#14315e" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <rect id="a-grant" x="2512" y="672" width="576" height="192" data-content="&lt;b&gt;Temporary access is activated&lt;/b&gt;&lt;br&gt;Verify the target privilege before use.&lt;br&gt;Record grant ID, start/end and actions.&lt;br&gt;Use only the approved task and scope." fill="#a0c4fb" stroke="#6a8bbf" stroke-width="2" data-text-color="#14315e" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <rect id="a-ending" x="1104" y="992" width="1984" height="160" data-content="&lt;b&gt;Entitlement = access definition; grant = one time-bound activation&lt;/b&gt;&lt;br&gt;Expiry or supported revocation ends the temporary grant. Verify the elevated action is denied after propagation; investigate other grants if access remains.&lt;br&gt;Baseline access continues only while its separate membership/role authorization remains valid." fill="#ddddd8" stroke="#a8a8a0" stroke-width="2" data-text-color="#434339" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <line id="a-l1" x1="1680.0" y1="416.0" x2="1808.0" y2="416.0" data-start="a-team" data-end="a-group" data-start-side="right" data-end-side="left" stroke="#313131" stroke-width="2" data-arrow="end" data-shape="elbowed" data-content="Map" />
    <line id="a-l2" x1="2384.0" y1="416.0" x2="2512.0" y2="416.0" data-start="a-group" data-end="a-baseline" data-start-side="right" data-end-side="left" stroke="#313131" stroke-width="2" data-arrow="end" data-shape="elbowed" data-content="Baseline" />
    <line id="a-l3" x1="1680.0" y1="768.0" x2="1808.0" y2="768.0" data-start="a-catalog" data-end="a-request" data-start-side="right" data-end-side="left" stroke="#313131" stroke-width="2" data-arrow="end" data-shape="elbowed" data-content="Request" />
    <line id="a-l4" x1="2384.0" y1="768.0" x2="2512.0" y2="768.0" data-start="a-request" data-end="a-grant" data-start-side="right" data-end-side="left" stroke="#313131" stroke-width="2" data-arrow="end" data-shape="elbowed" data-content="Authorized" />
    <line id="a-l5" x1="2096.0" y1="512.0" x2="2096.0" y2="672.0" data-start="a-group" data-end="a-request" data-start-side="bottom" data-end-side="top" stroke="#313131" stroke-width="2" data-arrow="end" data-shape="elbowed" data-content="Eligibility" />
    <line id="a-l6" x1="2800.0" y1="864.0" x2="2096.0" y2="992.0" data-start="a-grant" data-end="a-ending" data-start-side="bottom" data-end-side="top" stroke="#313131" stroke-width="2" data-arrow="end" data-shape="elbowed" data-content="Ends" />
    <textArea id="a-outcomes-title" x="64" y="1180" width="960" height="40" fill="#1a1a1a" font-family="noto_sans" font-size="22" text-align="left" font-weight="bold">Expected outcomes</textArea>
    <textArea id="a-fields-title" x="1088" y="1180" width="960" height="40" fill="#1a1a1a" font-family="noto_sans" font-size="22" text-align="left" font-weight="bold">Entitlement catalog fields to agree</textArea>
    <textArea id="a-decisions-title" x="2112" y="1180" width="976" height="40" fill="#1a1a1a" font-family="noto_sans" font-size="22" text-align="left" font-weight="bold">Decisions for the team</textArea>
    <rect id="a-outcomes" x="64" y="1244" width="960" height="192" data-content="• Normal tasks use understandable baseline permissions.&lt;br&gt;• Additional privilege has a task, scope and end time.&lt;br&gt;• Owners can trace who requested, approved and used it.&lt;br&gt;• Removal is tested and lingering access gets follow-up." fill="#a0c4fb" stroke="#6a8bbf" stroke-width="2" data-text-color="#14315e" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <rect id="a-fields" x="1088" y="1244" width="960" height="192" data-content="• Meaningful name, purpose, target system and scope.&lt;br&gt;• Roles, eligible identities/groups and mapping.&lt;br&gt;• Approval/justification policy and maximum duration.&lt;br&gt;• Owner, audit, revocation and verification requirements." fill="#ddddd8" stroke="#a8a8a0" stroke-width="2" data-text-color="#434339" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <rect id="a-decisions" x="2112" y="1244" width="976" height="192" data-content="• Baseline versus elevated tasks and target systems.&lt;br&gt;• Eligible requesters, approvals and bounded duration.&lt;br&gt;• Activation/removal behavior, emergency access and support.&lt;br&gt;• Remaining standing grants, evidence and review cadence." fill="#ffe86d" stroke="#cbb333" stroke-width="2" data-text-color="#574900" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <rect id="a-targets" x="64" y="1500" width="3024" height="192" data-content="&lt;b&gt;Choose and validate an elevation mechanism for each target&lt;/b&gt;&lt;br&gt;Google Cloud: evaluate &lt;a href=&quot;https://docs.cloud.google.com/iam/docs/pam-overview&quot;&gt;Google Cloud PAM&lt;/a&gt; for selected IAM roles and resource scope using the identity model in &lt;a href=&quot;https://miro.com/app/board/uXjVEOGaQYU=/?moveToWidget=3458764690610675776&quot;&gt;08A&lt;/a&gt;.&lt;br&gt;GitHub: define a separate supported mechanism against &lt;a href=&quot;https://miro.com/app/board/uXjVEOGaQYU=/?moveToWidget=3458764690640001435&quot;&gt;09A&lt;/a&gt;. &lt;a href=&quot;https://learn.microsoft.com/en-us/entra/id-governance/privileged-identity-management/concept-pim-for-groups&quot;&gt;Entra PIM for Groups&lt;/a&gt; is a candidate to evaluate; downstream activation/removal and sync delays must be proven. Google Cloud PAM is not a direct GitHub permission grant." fill="#ddddd8" stroke="#a8a8a0" stroke-width="2" data-text-color="#434339" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <textArea id="a-evidence" x="64" y="1810" width="3024" height="40" fill="#595959" font-family="noto_sans" font-size="18" text-align="left" font-weight="normal">Basis: proposal notes; Nov 12 discussion (07:43–10:37); Google PAM and Entra PIM references checked Nov 16, 2026. Targets, roles, policies and tools remain proposed.</textArea>
  </g>
  <g id="p10b" transform="translate(1275,30500)" data-frame="10B Temporary elevation: request, authorize, use and verify removal">
    <rect data-type="frame" x="0" y="0" width="3152" height="1910" fill="#ffffff" data-title="10B Temporary elevation: request, authorize, use and verify removal" />
    <textArea id="p10b-title" x="64" y="64" width="3024" height="64" fill="#1a1a1a" font-family="noto_sans" font-size="33" text-align="left" font-weight="bold">10B Temporary elevation: request, authorize, use and verify removal</textArea>
    <textArea id="p10b-subtitle" x="64" y="148" width="3024" height="40" fill="#595959" font-family="noto_sans" font-size="22" text-align="left" font-weight="normal">Requester / access owners / approvers / elevation service / target operators | Draft | Verify access before the task and verify its removal when the grant ends.</textArea>
    <textArea id="p10b-legend" x="64" y="1750" width="3024" height="40" fill="#595959" font-family="noto_sans" font-size="18" text-align="left" font-weight="normal">Blue = proposed | Gray = reported context or reference | Yellow = exception, boundary or team decision</textArea>
    <rect id="b-lane-request" x="64" y="264" width="3024" height="224" fill="#f7f7f7" stroke="none" />
    <textArea id="b-role-request" x="88" y="280" width="256" height="40" fill="#1a1a1a" font-family="noto_sans" font-size="18" text-align="left" font-weight="bold">Requester / task</textArea>
    <rect id="b-lane-policy" x="64" y="552" width="3024" height="224" fill="#f7f7f7" stroke="none" />
    <textArea id="b-role-policy" x="88" y="568" width="256" height="40" fill="#1a1a1a" font-family="noto_sans" font-size="18" text-align="left" font-weight="bold">Eligibility / authorization</textArea>
    <rect id="b-lane-activate" x="64" y="840" width="3024" height="224" fill="#f7f7f7" stroke="none" />
    <textArea id="b-role-activate" x="88" y="856" width="256" height="40" fill="#1a1a1a" font-family="noto_sans" font-size="18" text-align="left" font-weight="bold">Target activation / checks</textArea>
    <rect id="b-lane-use" x="64" y="1128" width="3024" height="224" fill="#f7f7f7" stroke="none" />
    <textArea id="b-role-use" x="88" y="1144" width="256" height="40" fill="#1a1a1a" font-family="noto_sans" font-size="18" text-align="left" font-weight="bold">Task / grant ending</textArea>
    <rect id="b-lane-verify" x="64" y="1416" width="3024" height="256" fill="#f7f7f7" stroke="none" />
    <textArea id="b-role-verify" x="88" y="1432" width="256" height="40" fill="#1a1a1a" font-family="noto_sans" font-size="18" text-align="left" font-weight="bold">Verification / audit owners</textArea>
    <rect id="b-need" x="440" y="280" width="640" height="192" data-content="&lt;b&gt;1. Identify a privileged task [Requester]&lt;/b&gt;&lt;br&gt;State target, operation and reason for more access.&lt;br&gt;Select an approved entitlement and duration.&lt;br&gt;If baseline is sufficient, use the normal workflow." fill="#a0c4fb" stroke="#6a8bbf" stroke-width="2" data-text-color="#14315e" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <rect id="b-denied" x="1272" y="280" width="640" height="192" data-content="&lt;b&gt;Ineligible, declined or request expired&lt;/b&gt;&lt;br&gt;Return the policy/approval outcome to the requester.&lt;br&gt;Do not activate elevated access.&lt;br&gt;Correct the request or follow the agreed review path." fill="#ffe86d" stroke="#cbb333" stroke-width="2" data-text-color="#574900" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <rect id="b-grant-failed" x="2104" y="280" width="840" height="192" data-content="&lt;b&gt;Grant creation or activation fails&lt;/b&gt;&lt;br&gt;Track the actual grant/target state; do not assume access is active.&lt;br&gt;Assigned owners reconcile partial changes and record recovery.&lt;br&gt;Repeat verification or end the failed grant under the agreed policy." fill="#ffe86d" stroke="#cbb333" stroke-width="2" data-text-color="#574900" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <rect id="b-validate" x="440" y="568" width="640" height="192" data-content="&lt;b&gt;2. Validate request [Elevation service]&lt;/b&gt;&lt;br&gt;Check requester eligibility and entitlement scope.&lt;br&gt;Apply reason/duration requirements and limits.&lt;br&gt;Reject unsupported or out-of-scope requests." fill="#a0c4fb" stroke="#6a8bbf" stroke-width="2" data-text-color="#14315e" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <rect id="b-authorize" x="1272" y="568" width="640" height="192" data-content="&lt;b&gt;3. Authorize under the entitlement policy&lt;/b&gt;&lt;br&gt;Apply configured approval/control requirements.&lt;br&gt;Approver(s) decide where the policy requires them.&lt;br&gt;Pending requests grant no elevated access." fill="#a0c4fb" stroke="#6a8bbf" stroke-width="2" data-text-color="#14315e" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <rect id="b-issue" x="2104" y="568" width="840" height="192" data-content="&lt;b&gt;4. Issue a time-bound grant [Elevation service]&lt;/b&gt;&lt;br&gt;Record requester, target, roles and grant start/end.&lt;br&gt;Proceed only when the configured policy is satisfied.&lt;br&gt;Track activation, expiry and assigned failure ownership." fill="#a0c4fb" stroke="#6a8bbf" stroke-width="2" data-text-color="#14315e" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <rect id="b-not-active" x="440" y="856" width="640" height="192" data-content="&lt;b&gt;Access is not active or scope is wrong&lt;/b&gt;&lt;br&gt;Hold the privileged task; owners check target state.&lt;br&gt;Check identity, roles and propagation status.&lt;br&gt;Repeat verification or end the failed grant." fill="#ffe86d" stroke="#cbb333" stroke-width="2" data-text-color="#574900" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <rect id="b-verify-active" x="1272" y="856" width="640" height="192" data-content="&lt;b&gt;6. Verify effective access [Requester / owner]&lt;/b&gt;&lt;br&gt;Check the approved action on the correct target.&lt;br&gt;Confirm the grant is active before the task.&lt;br&gt;Record verification and the remaining time window." fill="#a0c4fb" stroke="#6a8bbf" stroke-width="2" data-text-color="#14315e" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <rect id="b-activate" x="2104" y="856" width="840" height="192" data-content="&lt;b&gt;5. Apply target access [Selected mechanism]&lt;/b&gt;&lt;br&gt;Use the target-specific IAM or membership change.&lt;br&gt;Watch activation state and allow for propagation.&lt;br&gt;Google Cloud and GitHub implementations are validated separately." fill="#a0c4fb" stroke="#6a8bbf" stroke-width="2" data-text-color="#14315e" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <rect id="b-task-issue" x="440" y="1144" width="640" height="192" data-content="&lt;b&gt;Task fails, overruns or needs early removal&lt;/b&gt;&lt;br&gt;Stop privileged work if the grant ends.&lt;br&gt;Use a new request for a new access window.&lt;br&gt;Record failure and use supported revocation as needed." fill="#ffe86d" stroke="#cbb333" stroke-width="2" data-text-color="#574900" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <rect id="b-task" x="1272" y="1144" width="640" height="192" data-content="&lt;b&gt;7. Perform the approved task [Requester]&lt;/b&gt;&lt;br&gt;Use only the authorized operation and scope.&lt;br&gt;Follow change/review and runbook controls.&lt;br&gt;Record actions and results during the grant window." fill="#a0c4fb" stroke="#6a8bbf" stroke-width="2" data-text-color="#14315e" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <rect id="b-end" x="2104" y="1144" width="840" height="192" data-content="&lt;b&gt;8. End the grant [Service / authorized revoker]&lt;/b&gt;&lt;br&gt;Expiry ends elevation; supported revocation can end it earlier.&lt;br&gt;Track target removal and propagation under the selected mechanism.&lt;br&gt;Early task completion follows the agreed early-ending policy." fill="#a0c4fb" stroke="#6a8bbf" stroke-width="2" data-text-color="#14315e" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <rect id="b-removal-mismatch" x="440" y="1432" width="1472" height="224" data-content="&lt;b&gt;Removal mismatch: keep follow-up open&lt;/b&gt;&lt;br&gt;If the elevated action still works, reconcile target bindings/membership, sessions and other grants.&lt;br&gt;Assign an access owner, record the exception and escalate unresolved removal.&lt;br&gt;Correct the approved scope and repeat the denial check; retain legitimate baseline access only while separately authorized." fill="#ffe86d" stroke="#cbb333" stroke-width="2" data-text-color="#574900" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <rect id="b-close" x="2104" y="1432" width="840" height="224" data-content="&lt;b&gt;9. Verify the end and retain evidence [Owner / service]&lt;/b&gt;&lt;br&gt;Test that elevated access is denied after agreed propagation.&lt;br&gt;Check remaining grants if the action is still allowed.&lt;br&gt;Keep baseline only if its separate authorization remains valid.&lt;br&gt;Retain request, decision, grant, action and removal records." fill="#a0c4fb" stroke="#6a8bbf" stroke-width="2" data-text-color="#14315e" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <line id="b-l1" x1="760.0" y1="472.0" x2="760.0" y2="568.0" data-start="b-need" data-end="b-validate" data-start-side="bottom" data-end-side="top" stroke="#313131" stroke-width="2" data-arrow="end" data-shape="elbowed" data-content="Needed" />
    <line id="b-l2" x1="1080.0" y1="664.0" x2="1272.0" y2="664.0" data-start="b-validate" data-end="b-authorize" data-start-side="right" data-end-side="left" stroke="#313131" stroke-width="2" data-arrow="end" data-shape="elbowed" data-content="Eligible" />
    <line id="b-l3" x1="1912.0" y1="664.0" x2="2104.0" y2="664.0" data-start="b-authorize" data-end="b-issue" data-start-side="right" data-end-side="left" stroke="#313131" stroke-width="2" data-arrow="end" data-shape="elbowed" data-content="Authorized" />
    <line id="b-l4" x1="2524.0" y1="760.0" x2="2524.0" y2="856.0" data-start="b-issue" data-end="b-activate" data-start-side="bottom" data-end-side="top" stroke="#313131" stroke-width="2" data-arrow="end" data-shape="elbowed" data-content="Activate" />
    <line id="b-l5" x1="2104.0" y1="952.0" x2="1912.0" y2="952.0" data-start="b-activate" data-end="b-verify-active" data-start-side="left" data-end-side="right" stroke="#313131" stroke-width="2" data-arrow="end" data-shape="elbowed" data-content="Check" />

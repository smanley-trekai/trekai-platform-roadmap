<svg xmlns="http://www.w3.org/2000/svg" width="11600" height="17600">
  <g id="p05a" transform="translate(-2560,15500)" data-frame="05A QA environments and lab: proposal">
    <rect data-type="frame" x="0" y="0" width="3152" height="1910" fill="#ffffff" data-title="05A QA environments and lab: proposal" />
    <textArea id="p05a-title" x="64" y="64" width="3024" height="64" fill="#1a1a1a" font-family="noto_sans" font-size="33" text-align="left" font-weight="bold">05A QA environments and lab: proposal</textArea>
    <textArea id="p05a-subtitle" x="64" y="148" width="3024" height="40" fill="#595959" font-family="noto_sans" font-size="22" text-align="left" font-weight="normal">CTO / QA / developers / DevOps | Draft | Give QA repeatable, test-specific environments with clear versions, ownership and lifecycle.</textArea>
    <textArea id="p05a-legend" x="64" y="1750" width="3024" height="40" fill="#595959" font-family="noto_sans" font-size="18" text-align="left" font-weight="normal">Blue = proposed | Gray = saved evidence or context | Yellow = gate, exception or team decision</textArea>
    <textArea id="a-current" x="64" y="244" width="880" height="40" fill="#1a1a1a" font-family="noto_sans" font-size="22" text-align="left" font-weight="bold">Saved baseline and the need raised by the team</textArea>
    <rect id="a-tl" x="64" y="320" width="880" height="180" data-content="&lt;b&gt;Trek Learning (Hub/LMS)&lt;/b&gt;&lt;br&gt;Shared dev, staging and production environments.&lt;br&gt;Recorded as running in the Nov 2 cloud inventory." fill="#ddddd8" stroke="#a8a8a0" stroke-width="2" data-text-color="#434339" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <rect id="a-cap" x="64" y="532" width="880" height="180" data-content="&lt;b&gt;TrekCAP / TrekFinder&lt;/b&gt;&lt;br&gt;RD is the identified environment.&lt;br&gt;An on-demand QA lab workflow is not established." fill="#ddddd8" stroke="#a8a8a0" stroke-width="2" data-text-color="#434339" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <rect id="a-need" x="64" y="744" width="880" height="224" data-content="&lt;b&gt;Need discussed on Nov 12&lt;/b&gt;&lt;br&gt;QA must identify exactly what it is testing.&lt;br&gt;Provision through reusable code where approved.&lt;br&gt;Different tests or a quick POC may need separate labs." fill="#ffe86d" stroke="#cbb333" stroke-width="2" data-text-color="#574900" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <textArea id="a-proposed" x="1104" y="244" width="1984" height="40" fill="#1a1a1a" font-family="noto_sans" font-size="22" text-align="left" font-weight="bold">Proposed: QA selects a manifest and an approved lab profile</textArea>
    <rect id="a-entry" x="1104" y="320" width="1984" height="160" data-content="&lt;b&gt;QA starts an approved provisioning workflow&lt;/b&gt;&lt;br&gt;Choose product, release versions, test purpose and a bounded profile.&lt;br&gt;Interface remains to agree: workflow/button or direct Terraform access." fill="#a0c4fb" stroke="#6a8bbf" stroke-width="2" data-text-color="#14315e" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <textArea id="a-example-title" x="1104" y="544" width="1984" height="40" fill="#1a1a1a" font-family="noto_sans" font-size="22" text-align="left" font-weight="bold">Illustrative concurrent instances; quantity, size and isolation remain to agree</textArea>
    <rect id="a-functional" x="1104" y="608" width="608" height="256" data-content="&lt;b&gt;Lab A: functional tests&lt;/b&gt;&lt;br&gt;Selected Hub/LMS services.&lt;br&gt;Approved test data and dependencies.&lt;br&gt;Readiness checks before QA starts." fill="#a0c4fb" stroke="#6a8bbf" stroke-width="2" data-text-color="#14315e" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <rect id="a-load" x="1776" y="608" width="608" height="256" data-content="&lt;b&gt;Lab B: load or resilience tests&lt;/b&gt;&lt;br&gt;Selected product and test profile.&lt;br&gt;Isolation suited to the test impact.&lt;br&gt;Agreed resource and duration bounds." fill="#a0c4fb" stroke="#6a8bbf" stroke-width="2" data-text-color="#14315e" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <rect id="a-poc" x="2448" y="608" width="608" height="256" data-content="&lt;b&gt;Lab C: rapid POC&lt;/b&gt;&lt;br&gt;Approved subset or alternate setup.&lt;br&gt;Track deviations from the baseline.&lt;br&gt;Named owner and an expiry policy." fill="#a0c4fb" stroke="#6a8bbf" stroke-width="2" data-text-color="#14315e" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <rect id="a-isolation" x="1104" y="928" width="1984" height="160" data-content="&lt;b&gt;Choose isolation to match the test&lt;/b&gt;&lt;br&gt;Compare a lab in shared infrastructure with a dedicated project/cluster and data services.&lt;br&gt;Agree network, identity, state, test data and shared dependencies; a namespace alone may not meet every test need." fill="#ffe86d" stroke="#cbb333" stroke-width="2" data-text-color="#574900" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <textArea id="a-benefits-title" x="64" y="1180" width="960" height="40" fill="#1a1a1a" font-family="noto_sans" font-size="22" text-align="left" font-weight="bold">Expected outcomes</textArea>
    <textArea id="a-manifest-title" x="1088" y="1180" width="960" height="40" fill="#1a1a1a" font-family="noto_sans" font-size="22" text-align="left" font-weight="bold">Manifest fields to agree</textArea>
    <textArea id="a-lifecycle-title" x="2112" y="1180" width="976" height="40" fill="#1a1a1a" font-family="noto_sans" font-size="22" text-align="left" font-weight="bold">Controls and lifecycle</textArea>
    <rect id="a-benefits" x="64" y="1244" width="960" height="192" data-content="• Repeat a test against identifiable versions.&lt;br&gt;• Support different testing needs in parallel.&lt;br&gt;• Exercise provisioning and recreation from code." fill="#a0c4fb" stroke="#6a8bbf" stroke-width="2" data-text-color="#14315e" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <rect id="a-manifest" x="1088" y="1244" width="960" height="192" data-content="• Service images and infrastructure-template version.&lt;br&gt;• Settings, dependencies, schema and test-data profile.&lt;br&gt;• Owner, purpose, size, expiry and acceptance checks.&lt;br&gt;• References to secrets; no secret values in the manifest." fill="#ddddd8" stroke="#a8a8a0" stroke-width="2" data-text-color="#434339" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <rect id="a-lifecycle" x="2112" y="1244" width="976" height="192" data-content="• Scope execution access to the owned lab.&lt;br&gt;• Bound sizing, concurrency and allowed duration.&lt;br&gt;• Keep evidence, then verify managed cleanup.&lt;br&gt;• Assign failed-provisioning and cleanup ownership." fill="#ffe86d" stroke="#cbb333" stroke-width="2" data-text-color="#574900" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <rect id="a-boundary" x="64" y="1500" width="3024" height="192" data-content="&lt;b&gt;Infrastructure, deployment and QA are separate handoffs&lt;/b&gt;&lt;br&gt;Terraform provisions the approved target; the chosen app deployment path installs the selected release and test setup. Readiness checks precede QA tests.&lt;br&gt;Use &lt;a href=&quot;https://miro.com/app/board/uXjVEOGaQYU=/?moveToWidget=3458764690359619683&quot;&gt;Proposal 01 apply controls&lt;/a&gt;; consume approved artifacts from 03/04. Repository consolidation is not a prerequisite. Production promotion remains a separate release decision." fill="#ddddd8" stroke="#a8a8a0" stroke-width="2" data-text-color="#434339" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <textArea id="a-evidence" x="64" y="1810" width="3024" height="40" fill="#595959" font-family="noto_sans" font-size="18" text-align="left" font-weight="normal">Basis: Nov 12 proposal discussion; environment/runtime snapshots Nov 2–3, 2026. Lab profiles, manifest, instances, controls and self-service automation are proposed.</textArea>
  </g>
  <g id="p05b" transform="translate(1275,15500)" data-frame="05B QA lab: request, provision, test and clean up">
    <rect data-type="frame" x="0" y="0" width="3152" height="1910" fill="#ffffff" data-title="05B QA lab: request, provision, test and clean up" />
    <textArea id="p05b-title" x="64" y="64" width="3024" height="64" fill="#1a1a1a" font-family="noto_sans" font-size="33" text-align="left" font-weight="bold">05B QA lab: request, provision, test and clean up</textArea>
    <textArea id="p05b-subtitle" x="64" y="148" width="3024" height="40" fill="#595959" font-family="noto_sans" font-size="22" text-align="left" font-weight="normal">QA / automation / approvers / DevOps | Draft | Follow the numbered handoffs; request ownership, readiness and cleanup evidence stay with each instance.</textArea>
    <textArea id="p05b-legend" x="64" y="1750" width="3024" height="40" fill="#595959" font-family="noto_sans" font-size="18" text-align="left" font-weight="normal">Blue = proposed | Gray = saved evidence or context | Yellow = gate, exception or team decision</textArea>
    <rect id="b-lane-qa-request" x="64" y="264" width="3024" height="224" fill="#f7f7f7" stroke="none" />
    <textArea id="b-role-qa-request" x="88" y="280" width="256" height="40" fill="#1a1a1a" font-family="noto_sans" font-size="18" text-align="left" font-weight="bold">QA requests / feedback</textArea>
    <rect id="b-lane-provision" x="64" y="552" width="3024" height="224" fill="#f7f7f7" stroke="none" />
    <textArea id="b-role-provision" x="88" y="568" width="256" height="40" fill="#1a1a1a" font-family="noto_sans" font-size="18" text-align="left" font-weight="bold">Provisioning / approvals</textArea>
    <rect id="b-lane-deploy" x="64" y="840" width="3024" height="224" fill="#f7f7f7" stroke="none" />
    <textArea id="b-role-deploy" x="88" y="856" width="256" height="40" fill="#1a1a1a" font-family="noto_sans" font-size="18" text-align="left" font-weight="bold">Apps / readiness</textArea>
    <rect id="b-lane-qa-test" x="64" y="1128" width="3024" height="224" fill="#f7f7f7" stroke="none" />
    <textArea id="b-role-qa-test" x="88" y="1144" width="256" height="40" fill="#1a1a1a" font-family="noto_sans" font-size="18" text-align="left" font-weight="bold">QA tests / evidence</textArea>
    <rect id="b-lane-lifecycle" x="64" y="1416" width="3024" height="256" fill="#f7f7f7" stroke="none" />
    <textArea id="b-role-lifecycle" x="88" y="1432" width="256" height="40" fill="#1a1a1a" font-family="noto_sans" font-size="18" text-align="left" font-weight="bold">Lifecycle / DevOps</textArea>
    <rect id="b-request" x="440" y="280" width="640" height="192" data-content="&lt;b&gt;1. Select what to test [QA]&lt;/b&gt;&lt;br&gt;Choose a release manifest and lab profile.&lt;br&gt;Provide purpose, owner and requested lifetime.&lt;br&gt;Submit through the agreed interface." fill="#a0c4fb" stroke="#6a8bbf" stroke-width="2" data-text-color="#14315e" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <rect id="b-invalid" x="1272" y="280" width="640" height="192" data-content="&lt;b&gt;Incomplete or unauthorized request&lt;/b&gt;&lt;br&gt;Return clear findings to QA; do not provision.&lt;br&gt;Correct inputs or obtain the required approval." fill="#ffe86d" stroke="#cbb333" stroke-width="2" data-text-color="#574900" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <rect id="b-partial" x="2104" y="280" width="840" height="192" data-content="&lt;b&gt;Provisioning failed or only partly completed&lt;/b&gt;&lt;br&gt;Do not start testing or assume automatic rollback.&lt;br&gt;DevOps reconciles the owned resources and state.&lt;br&gt;Record recovery or cleanup actions." fill="#ffe86d" stroke="#cbb333" stroke-width="2" data-text-color="#574900" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <rect id="b-policy" x="440" y="568" width="640" height="192" data-content="&lt;b&gt;2. Validate the request [Automation]&lt;/b&gt;&lt;br&gt;Check profile, versions, access and limits.&lt;br&gt;Allocate an instance ID and ownership scope.&lt;br&gt;Confirm any required request approval." fill="#a0c4fb" stroke="#6a8bbf" stroke-width="2" data-text-color="#14315e" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <rect id="b-plan" x="1272" y="568" width="640" height="192" data-content="&lt;b&gt;3. Review the final target plan&lt;/b&gt;&lt;br&gt;Select lab inputs and isolated state scope.&lt;br&gt;Authorize execution under the agreed policy.&lt;br&gt;Apply controls: &lt;a href=&quot;https://miro.com/app/board/uXjVEOGaQYU=/?moveToWidget=3458764690359619683&quot;&gt;01B&lt;/a&gt; (review or approved policy)." fill="#a0c4fb" stroke="#6a8bbf" stroke-width="2" data-text-color="#14315e" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <rect id="b-apply" x="2104" y="568" width="840" height="192" data-content="&lt;b&gt;4. Provision infrastructure [Automation]&lt;/b&gt;&lt;br&gt;A scoped executor runs Terraform for this lab.&lt;br&gt;Verify resources and capture required outputs.&lt;br&gt;Stop on failed or partial apply." fill="#a0c4fb" stroke="#6a8bbf" stroke-width="2" data-text-color="#14315e" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <rect id="b-deploy" x="2104" y="856" width="840" height="192" data-content="&lt;b&gt;5. Deploy the selected release [Automation]&lt;/b&gt;&lt;br&gt;Deploy manifest versions and required dependencies.&lt;br&gt;Apply the agreed test schema and seed approved data.&lt;br&gt;Application deployment is separate from Terraform apply." fill="#a0c4fb" stroke="#6a8bbf" stroke-width="2" data-text-color="#14315e" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <rect id="b-ready" x="1272" y="856" width="640" height="192" data-content="&lt;b&gt;6. Check lab readiness [Automation]&lt;/b&gt;&lt;br&gt;Verify settings, access and dependencies.&lt;br&gt;Match release versions and check health.&lt;br&gt;Hand over only a ready instance to QA." fill="#a0c4fb" stroke="#6a8bbf" stroke-width="2" data-text-color="#14315e" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <rect id="b-not-ready" x="440" y="856" width="640" height="192" data-content="&lt;b&gt;Lab is not ready: hold QA testing&lt;/b&gt;&lt;br&gt;Return deployment/readiness diagnostics.&lt;br&gt;Assigned owners correct the setup.&lt;br&gt;Repeat the readiness checks." fill="#ffe86d" stroke="#cbb333" stroke-width="2" data-text-color="#574900" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <rect id="b-tests" x="1272" y="1144" width="640" height="192" data-content="&lt;b&gt;7. Run the selected tests [QA]&lt;/b&gt;&lt;br&gt;Use the manifest and instance ID.&lt;br&gt;Execute functional, load, recovery or POC tests.&lt;br&gt;Record failures as well as passes." fill="#a0c4fb" stroke="#6a8bbf" stroke-width="2" data-text-color="#14315e" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <rect id="b-results" x="2104" y="1144" width="840" height="192" data-content="&lt;b&gt;8. Save results and evidence [QA / Automation]&lt;/b&gt;&lt;br&gt;Record manifest, instance, versions and test outcomes.&lt;br&gt;Separate product defects from environment failures.&lt;br&gt;Retain agreed evidence before removing the lab." fill="#a0c4fb" stroke="#6a8bbf" stroke-width="2" data-text-color="#14315e" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <rect id="b-expiry" x="440" y="1432" width="1472" height="224" data-content="&lt;b&gt;Completion or expiry starts the agreed lifecycle policy&lt;/b&gt;&lt;br&gt;Track the owner, expiry, retention and any approved extension.&lt;br&gt;Keep shared/protected dependencies outside this lab’s teardown scope.&lt;br&gt;If cleanup fails, assign follow-up and track residual resources and cost." fill="#ddddd8" stroke="#a8a8a0" stroke-width="2" data-text-color="#434339" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <rect id="b-cleanup" x="2104" y="1432" width="840" height="224" data-content="&lt;b&gt;9. Remove only the owned lab [Automation]&lt;/b&gt;&lt;br&gt;Stop/remove its deployment desired state.&lt;br&gt;Authorize and run target cleanup under the agreed policy.&lt;br&gt;Verify owned resources and record any residue.&lt;br&gt;Retain the agreed evidence and closure record." fill="#a0c4fb" stroke="#6a8bbf" stroke-width="2" data-text-color="#14315e" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
    <line id="b-l1" x1="760.0" y1="472.0" x2="760.0" y2="568.0" data-start="b-request" data-end="b-policy" data-start-side="bottom" data-end-side="top" stroke="#313131" stroke-width="2" data-arrow="end" data-shape="elbowed" data-content="Request" />
    <line id="b-l2" x1="1080.0" y1="664.0" x2="1272.0" y2="664.0" data-start="b-policy" data-end="b-plan" data-start-side="right" data-end-side="left" stroke="#313131" stroke-width="2" data-arrow="end" data-shape="elbowed" data-content="Valid" />
    <line id="b-l3" x1="1912.0" y1="664.0" x2="2104.0" y2="664.0" data-start="b-plan" data-end="b-apply" data-start-side="right" data-end-side="left" stroke="#313131" stroke-width="2" data-arrow="end" data-shape="elbowed" data-content="Authorized" />
    <line id="b-l4" x1="2524.0" y1="760.0" x2="2524.0" y2="856.0" data-start="b-apply" data-end="b-deploy" data-start-side="bottom" data-end-side="top" stroke="#313131" stroke-width="2" data-arrow="end" data-shape="elbowed" data-content="Infra ready" />
    <line id="b-l5" x1="2104.0" y1="952.0" x2="1912.0" y2="952.0" data-start="b-deploy" data-end="b-ready" data-start-side="left" data-end-side="right" stroke="#313131" stroke-width="2" data-arrow="end" data-shape="elbowed" data-content="Release installed" />
    <line id="b-l6" x1="1592.0" y1="1048.0" x2="1592.0" y2="1144.0" data-start="b-ready" data-end="b-tests" data-start-side="bottom" data-end-side="top" stroke="#313131" stroke-width="2" data-arrow="end" data-shape="elbowed" data-content="Ready" />
    <line id="b-l7" x1="1912.0" y1="1240.0" x2="2104.0" y2="1240.0" data-start="b-tests" data-end="b-results" data-start-side="right" data-end-side="left" stroke="#313131" stroke-width="2" data-arrow="end" data-shape="elbowed" data-content="Outcome" />
    <line id="b-l8" x1="2524.0" y1="1336.0" x2="2524.0" y2="1432.0" data-start="b-results" data-end="b-cleanup" data-start-side="bottom" data-end-side="top" stroke="#313131" stroke-width="2" data-arrow="end" data-shape="elbowed" data-content="End / expiry" />
    <line id="b-invalid-link" x1="760.0" y1="568.0" x2="1592.0" y2="472.0" data-start="b-policy" data-end="b-invalid" data-start-side="top" data-end-side="bottom" stroke="#313131" stroke-width="2" data-arrow="end" data-shape="elbowed" data-content="Invalid / denied" />
    <line id="b-partial-link" x1="2524.0" y1="568.0" x2="2524.0" y2="472.0" data-start="b-apply" data-end="b-partial" data-start-side="top" data-end-side="bottom" stroke="#313131" stroke-width="2" data-arrow="end" data-shape="elbowed" data-content="Failed / partial" />
    <line id="b-not-ready-link" x1="1272.0" y1="952.0" x2="1080.0" y2="952.0" data-start="b-ready" data-end="b-not-ready" data-start-side="left" data-end-side="right" stroke="#313131" stroke-width="2" data-arrow="end" data-shape="elbowed" data-content="Not ready" />
    <textArea id="b-evidence" x="64" y="1810" width="3024" height="40" fill="#595959" font-family="noto_sans" font-size="18" text-align="left" font-weight="normal">Proposed workflow, not an existing QA provisioning service. Interface, approvals, deployment engine, test data, isolation and expiry/cleanup policy require team agreement.</textArea>
  </g>
  <g id="p05c" transform="translate(5110,15500)" data-frame="05C QA lab: delivery plan and operating controls">
    <rect data-type="frame" x="0" y="0" width="3152" height="1910" fill="#ffffff" data-title="05C QA lab: delivery plan and operating controls" />
    <textArea id="p05c-title" x="64" y="64" width="3024" height="64" fill="#1a1a1a" font-family="noto_sans" font-size="33" text-align="left" font-weight="bold">05C QA lab: delivery plan and operating controls</textArea>
    <textArea id="p05c-subtitle" x="64" y="148" width="3024" height="40" fill="#595959" font-family="noto_sans" font-size="22" text-align="left" font-weight="normal">QA / application teams / DevOps | Draft | Pilot one reproducible profile, verify failure and cleanup behavior, then expand to agreed testing needs.</textArea>
    <textArea id="p05c-legend" x="64" y="1750" width="3024" height="40" fill="#595959" font-family="noto_sans" font-size="18" text-align="left" font-weight="normal">Blue = proposed | Gray = saved evidence or context | Yellow = gate, exception or team decision</textArea>
    <textArea id="c-work" x="64" y="244" width="3024" height="40" fill="#1a1a1a" font-family="noto_sans" font-size="22" text-align="left" font-weight="bold">Proposed work packages</textArea>
    <rect id="c-needs" x="64" y="328" width="636" height="256" data-content="&lt;b&gt;1. Agree what QA needs&lt;/b&gt;&lt;br&gt;List functional, load, recovery and POC scenarios.&lt;br&gt;Map services, dependencies and data needs.&lt;br&gt;Check which infrastructure can be recreated from code." fill="#a0c4fb" stroke="#6a8bbf" stroke-width="2" data-text-color="#14315e" data-font-family="noto_sans" data-font-size="22" data-text-align="left" data-text-align-vertical="middle" />
